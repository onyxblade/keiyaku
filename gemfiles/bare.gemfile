# frozen_string_literal: true

# The bundle an application that just calls an API would have: keiyaku, and
# nothing else. The main Gemfile carries faraday and http.rb so the optional
# adapters are covered by the suite, which means it cannot answer the question
# those adapters exist to make true — that neither gem is needed. This one can.
#
# Run it with `BUNDLE_GEMFILE=gemfiles/bare.gemfile bundle exec rspec`.

source "https://rubygems.org"

gemspec path: ".."

gem "rake", "~> 13.0"
gem "rspec", "~> 3.13"
